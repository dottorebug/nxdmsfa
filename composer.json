{
    "name": "dottorebug/nxdmsfa",
    "description": "Host-agnostic PHP application for Nextcloud (and other hosts in the future).",
    "type": "nextcloud",
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "dottorebug",
            "type": "Individual"
        }
    ],
    "require": {
        "php": "^8.1",
        "nextcloud/server": "^34.0"
    },
    "autoload": {
        "psr-4": {
            "OCA\\Nxdmsfa\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OCA\\Nxdmsfa\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
